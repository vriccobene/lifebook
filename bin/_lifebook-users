#!/usr/bin/env bash
# Shared by the user commands in bin/: runs the users script of the API on the database in
# $LIFEBOOK_DB (default: apps/lifebook-api/data/lifebook.sqlite), from any directory. With LIFEBOOK_DOCKER=1
# they run inside the `api` container of docker-compose.yml instead, on its /data volume.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
API="$ROOT/apps/lifebook-api"
if [[ -n "${LIFEBOOK_DB:-}" ]]; then
  LIFEBOOK_DB="$(readlink -m "$LIFEBOOK_DB")"
  export LIFEBOOK_DB
fi

# Asks for a password twice without echoing it; prints it on stdout.
ask_password() {
  local first second
  read -rsp "Nuova password: " first </dev/tty; echo >&2
  read -rsp "Ripeti la password: " second </dev/tty; echo >&2
  if [[ "$first" != "$second" ]]; then echo "Le password non coincidono." >&2; return 1; fi
  printf '%s' "$first"
}

run_users() {
  if [[ "${LIFEBOOK_DOCKER:-}" == 1 ]]; then
    # Prompts run here on the host, so the container needs no terminal.
    exec docker compose -f "$ROOT/docker-compose.yml" exec -T api pnpm --silent users "$@"
  fi
  cd "$API" && exec "$API/node_modules/.bin/tsx" src/scripts/users.ts "$@"
}
